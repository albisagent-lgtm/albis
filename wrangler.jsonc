{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albis",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Smart placement: once Cloudflare learns the Worker's subrequest pattern,
  // it relocates the isolate close to the hottest origin — for us that's
  // Supabase's PostgREST endpoint. Origin sits in APAC (cf-ray returned AKL
  // for UK requests), so without placement every DB call cost ~500ms RTT.
  // With placement, Supabase round-trips drop to ~20–50ms intra-region.
  "placement": { "mode": "smart" },
  // Plain-text vars live here so `wrangler deploy` does not treat
  // Dashboard-set values as drift and wipe them. Secrets (service role key,
  // Stripe keys, Resend key, SCAN_INGEST_KEY, PEXELS_API_KEY) stay in the
  // Cloudflare Dashboard as encrypted secrets — NEVER add them here.
  // NEXT_PUBLIC_* values are already shipped in the browser bundle; the
  // Supabase anon key is RLS-protected, not secret. NODE_ENV has no
  // security implications.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://wguydvzpxwsgrhvojpnk.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TijRtvYeJ-iL8HhhS8NpMg_zbla_orj",
    "NEXT_PUBLIC_SITE_URL": "https://www.albis.news",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_51TLeiCLUymhPvjeE5e19STeNLtAUCvXNaUbWGEQ60uwz0vmYOyMxfZ7ithN8C6o4vI5st9We62AEPgZVw4Bsk9xO00BeNZ2MY6",
    "NODE_ENV": "production",
    "COMPANY_EMAIL_DELIVERY_ENABLED": "0",
    "COMPANY_EMAIL_DELIVERY_APPROVE_ALL": "0",
    "COMPANY_EMAIL_TEST_DELIVERY_ENABLED": "1",
    "COMPANY_EMAIL_TEST_RECIPIENTS": "hazzagazza6743@gmail.com",
    "COMPANY_EMAIL_DELIVERY_APPROVED_PROFILE_IDS": "6330ca52-2e75-49db-8c9a-5d97ad38a28a",
    "ALBIS_ENABLE_COMPANY_EDITORIAL_WRITER": "true",
    "ALBIS_EDITORIAL_MODEL_PROVIDER": "openclaw-system",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "albis",
    },
  ],
  // KV-backed incremental cache. Makes `revalidate = N` actually refresh.
  // Binding name is dictated by @opennextjs/cloudflare's kv-incremental-cache
  // override (BINDING_NAME = "NEXT_INC_CACHE_KV"). Don't rename.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "7dd33d8d4ce24c76904c2054e85a7e87",
    },
  ],
}
