{
  "name": "albis-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "tsx scripts/sync-scans.ts",
    "sync:today": "tsx scripts/sync-scans.ts --today",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "growth:desk": "tsx scripts/run-growth-desk.ts",
    "growth:report": "tsx scripts/run-growth-desk-daily-report.ts",
    "community:weather": "tsx scripts/run-community-weather-daily.ts --limit=100 --media-per-city=3",
    "community:weather:dry": "tsx scripts/run-community-weather-daily.ts --limit=10 --media-per-city=2",
    "intelligence:wiki:status": "tsx scripts/run-albis-intelligence-wiki.ts status",
    "intelligence:wiki:ingest-latest": "tsx scripts/run-albis-intelligence-wiki.ts ingest-latest",
    "intelligence:wiki:view": "tsx scripts/run-albis-intelligence-wiki.ts view",
    "outreach:public:dry-run": "tsx scripts/run-outreach-send.ts --campaign life-systems --dry-run --floor 1 --ceiling 5 --target-per-bucket 1",
    "outreach:public:send-small": "tsx scripts/run-outreach-send.ts --campaign life-systems --floor 1 --ceiling 10 --target-per-bucket 3"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@opennextjs/cloudflare": "^1.19.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.96.0",
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reading-time": "^1.5.0",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.59.2"
  }
}
